# ==============================================================================
# AquaGuard AI — Backend Environment Configuration Example
# Copy this file to .env for local overrides (never commit .env to version control)
# ==============================================================================

# Server Network Configuration (Render provides $PORT automatically)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Frontend Allowed Origin (for CORS)
# For local dev: http://localhost:5173
# For production: https://your-aquaguard-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Comma-separated additional allowed origins (optional)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: Path to custom pre-trained YOLO model weights (.pt / .onnx)
# If left unset, AquaGuard AI cleanly operates on the deterministic Computer Vision Fallback Engine
MODEL_PATH=

# Enable preview branch Vercel deployments (true/false)
ALLOW_VERCEL_PREVIEWS=true
